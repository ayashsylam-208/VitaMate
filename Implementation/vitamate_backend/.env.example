DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_DEV_ALLOW_ALL_HOSTS=1
DJANGO_DEV_CORS_ALLOW_ALL=1
# Set this only when you explicitly want SQLite fallback for local dev.
# VITAMATE_USE_SQLITE=1
POSTGRES_DB=vitamate
POSTGRES_USER=vitamate
POSTGRES_PASSWORD=vitamate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Internal AI service. Flutter must never call this URL directly.
AI_MEALS_BASE_URL=http://127.0.0.1:8010
AI_MEALS_TIMEOUT_SECONDS=180
AI_MEALS_SERVICE_TOKEN=replace-with-a-long-random-service-token
AI_MEALS_MAX_IMAGE_BYTES=10485760
AI_MEALS_SESSION_TTL_MINUTES=30
AI_MEALS_MIN_IMAGE_DIMENSION=128
AI_MEALS_MAX_IMAGE_DIMENSION=8192
AI_MEALS_MAX_IMAGE_PIXELS=40000000
AI_RUNTIME_MAX_CONCURRENCY=1
AI_RUNTIME_MAX_QUEUE_SIZE=2
AI_RUNTIME_QUEUE_TIMEOUT_SECONDS=20
# Development runserver starts the installed local AI runtime automatically.
VITAMATE_AI_START_TIMEOUT_SECONDS=60
VITAMATE_AI_READY_TIMEOUT_SECONDS=300
# Set to 1 only when intentionally running Django without meal photo analysis.
VITAMATE_SKIP_AI_SERVICE_BOOTSTRAP=0
